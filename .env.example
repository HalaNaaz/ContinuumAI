# ContinuumAI — Environment Variables Template
# Copy this file to .env and configure values before starting the application.
# NEVER commit .env to version control or expose secret keys in client-side bundles.

# ==========================================
# FalkorDB Configuration (Primary Graph DB)
# ==========================================
# For local Docker: host=localhost, port=6379, password=""
# For FalkorDB Cloud: host=<instance-endpoint>, port=<port>, password=<auth-token>
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=continuum_ai

# ==========================================
# LLM Provider Configuration
# ==========================================
# Supported providers: "mock" (for offline/deterministic testing), "gemini", "openai"
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# ==========================================
# Backend API Configuration
# ==========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# ==========================================
# Frontend Configuration (Next.js)
# ==========================================
# Only public variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
